#!/usr/bin/env bash
# ocvm - OpenCode Version Manager
# Manages multiple versions of custom OpenCode (oc)

set -e

OC_DIR="${OC_DIR:-$HOME/.oc}"
OC_VERSIONS_DIR="$OC_DIR/versions"
OC_CURRENT_LINK="$OC_DIR/current"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Detect platform and architecture
detect_platform() {
  local os arch
  
  case "$(uname -s)" in
    Darwin) os="darwin" ;;
    Linux) os="linux" ;;
    *) echo "Unsupported OS"; exit 1 ;;
  esac
  
  case "$(uname -m)" in
    arm64|aarch64) arch="arm64" ;;
    x86_64|amd64) arch="x64" ;;
    *) echo "Unsupported architecture"; exit 1 ;;
  esac
  
  echo "${os}-${arch}"
}

# Download and install a version
install_version() {
  local version=$1
  local platform=$(detect_platform)
  local version_dir="$OC_VERSIONS_DIR/$version"
  
  if [ -d "$version_dir" ]; then
    echo -e "${YELLOW}Version $version is already installed${NC}"
    return
  fi
  
  echo -e "${BLUE}Installing oc $version for $platform...${NC}"
  
  mkdir -p "$version_dir"
  
  # Determine download URL and file extension
  local url file_ext
  if [[ "$platform" == darwin-* ]]; then
    url="https://github.com/hungthai1401/opencode/releases/download/v${version}/oc-${platform}.zip"
    file_ext="zip"
  else
    url="https://github.com/hungthai1401/opencode/releases/download/v${version}/oc-${platform}.tar.gz"
    file_ext="tar.gz"
  fi
  
  # Download
  local tmp_file="/tmp/oc-${version}.${file_ext}"
  echo "Downloading from $url..."
  curl -fsSL "$url" -o "$tmp_file"
  
  # Extract
  if [ "$file_ext" = "zip" ]; then
    unzip -q "$tmp_file" -d "$version_dir"
  else
    tar -xzf "$tmp_file" -C "$version_dir"
  fi
  
  # Find and move the binary
  local binary=$(find "$version_dir" -name "opencode" -type f | head -1)
  if [ -z "$binary" ]; then
    echo -e "${RED}Error: Binary not found in archive${NC}"
    rm -rf "$version_dir"
    exit 1
  fi
  
  # Move binary to version root and make executable
  mv "$binary" "$version_dir/oc"
  chmod +x "$version_dir/oc"
  
  # Clean up extracted directories
  find "$version_dir" -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} \;
  
  rm "$tmp_file"
  
  echo -e "${GREEN}✓ Installed oc $version${NC}"
}

# Use a specific version
use_version() {
  local version=$1
  local version_dir="$OC_VERSIONS_DIR/$version"
  
  if [ ! -d "$version_dir" ]; then
    echo -e "${RED}Version $version is not installed${NC}"
    echo "Install it with: ocvm install $version"
    exit 1
  fi
  
  # Update symlink
  rm -f "$OC_CURRENT_LINK"
  ln -s "$version_dir" "$OC_CURRENT_LINK"
  
  echo -e "${GREEN}Now using oc $version${NC}"
}

# List installed versions
list_versions() {
  if [ ! -d "$OC_VERSIONS_DIR" ]; then
    echo "No versions installed"
    return
  fi
  
  local current_version=""
  if [ -L "$OC_CURRENT_LINK" ]; then
    current_version=$(basename "$(readlink "$OC_CURRENT_LINK")")
  fi
  
  echo "Installed versions:"
  for version_dir in "$OC_VERSIONS_DIR"/*; do
    if [ -d "$version_dir" ]; then
      local version=$(basename "$version_dir")
      if [ "$version" = "$current_version" ]; then
        echo -e "  ${GREEN}* $version (current)${NC}"
      else
        echo "    $version"
      fi
    fi
  done
}

# Uninstall a version
uninstall_version() {
  local version=$1
  local version_dir="$OC_VERSIONS_DIR/$version"
  
  if [ ! -d "$version_dir" ]; then
    echo -e "${RED}Version $version is not installed${NC}"
    exit 1
  fi
  
  # Check if it's the current version
  if [ -L "$OC_CURRENT_LINK" ] && [ "$(readlink "$OC_CURRENT_LINK")" = "$version_dir" ]; then
    echo -e "${YELLOW}Unlinking current version${NC}"
    rm -f "$OC_CURRENT_LINK"
  fi
  
  rm -rf "$version_dir"
  echo -e "${GREEN}✓ Uninstalled oc $version${NC}"
}

# Show current version
current_version() {
  if [ ! -L "$OC_CURRENT_LINK" ]; then
    echo "No version currently selected"
    echo "Use: ocvm use <version>"
    exit 1
  fi
  
  local version=$(basename "$(readlink "$OC_CURRENT_LINK")")
  echo "$version"
}

# Show help
show_help() {
  cat <<EOF
ocvm - OpenCode Version Manager

Usage:
  ocvm install <version>    Install a specific version
  ocvm use <version>        Switch to a specific version
  ocvm list                 List installed versions
  ocvm current              Show current version
  ocvm uninstall <version>  Uninstall a version
  ocvm help                 Show this help

Examples:
  ocvm install 1.15.11-custom
  ocvm use 1.15.11-custom
  ocvm list
  ocvm current

After installation, add to your shell profile:
  export PATH="\$HOME/.oc/current:\$PATH"

Then restart your shell or run:
  source ~/.bashrc  # or ~/.zshrc
EOF
}

# Main command dispatcher
case "${1:-}" in
  install)
    if [ -z "$2" ]; then
      echo "Usage: ocvm install <version>"
      exit 1
    fi
    install_version "$2"
    ;;
  use)
    if [ -z "$2" ]; then
      echo "Usage: ocvm use <version>"
      exit 1
    fi
    use_version "$2"
    ;;
  list|ls)
    list_versions
    ;;
  current)
    current_version
    ;;
  uninstall|remove)
    if [ -z "$2" ]; then
      echo "Usage: ocvm uninstall <version>"
      exit 1
    fi
    uninstall_version "$2"
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    show_help
    exit 1
    ;;
esac
